{
  "name": "@ankhorage/db-postgres",
  "version": "0.1.0",
  "description": "PostgreSQL adapter for @ankhorage/contracts/db.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc --noEmit -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "prepack": "bun run build",
    "test": "bun test src test",
    "test:integration": "bun test test/postgres.integration.test.ts",
    "typecheck": "bun run check-types",
    "version-packages": "ankhorage-changeset version"
  },
  "dependencies": {
    "@ankhorage/contracts": "^26.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.4.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/db-postgres.git"
  },
  "homepage": "https://github.com/ankhorage/db-postgres#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/db-postgres/issues"
  }
}
